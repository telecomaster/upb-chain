# ── Configuración de Nodo UPB-Chain ──────────────────────────────
# Copiar a .env y ajustar antes de ejecutar

# ID único del nodo (nodo1 es el primario PBFT)
NODE_ID=node_1

# Dirección de escucha del servidor P2P
NODE_HOST=0.0.0.0
NODE_PORT=8001

# Puerto de la API HTTP
API_PORT=8000

# Pares conocidos (host:port separados por coma)
# Para el nodo 2 apuntando al nodo 1:
# PEERS=192.168.1.100:8001
PEERS=

# Directorio de datos de la cadena
DATA_DIR=data/chain

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Dificultad inicial de minado (4 = ~segundos en RPi5)
MINING_DIFFICULTY=4
