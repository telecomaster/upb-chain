# ── Configuración de Nodo UPB-Chain ──────────────────────────────
# Copiar a .env y ajustar antes de ejecutar

# ID único del nodo (en PBFT debe figurar en PBFT_REPLICAS_FILE)
NODE_ID=node_1

# Dirección de escucha del servidor P2P
NODE_HOST=0.0.0.0
NODE_PORT=8001

# Dirección que se anuncia a los pares (IP/host alcanzable). Vacío = usar NODE_HOST.
# Necesaria cuando NODE_HOST=0.0.0.0.
NODE_ADVERTISE_HOST=

# Puerto de la API HTTP
API_PORT=8000

# Pares conocidos (host:port separados por coma)
# Para el nodo 2 apuntando al nodo 1:
# PEERS=192.168.1.100:8001
PEERS=

# P2P con TLS mutuo (P2-6): off | on (recomendado en las Pi). Con "on" se leen
# P2P_TLS_DIR/ca.crt, <NODE_ID>.crt y <NODE_ID>.key (scripts/crear_ca.py, scripts/emitir_cert_nodo.py).
# P2P_ALLOWLIST: node_ids permitidos (vacía: en pbft los ids de las réplicas; en pow, toda la CA).
P2P_TLS=off
P2P_TLS_DIR=data/tls
P2P_ALLOWLIST=
# Latido entre pares: un par que muere se marca caído en ~P2P_PING_INTERVAL s (antes, ~15 s).
# P2P_PING_TIMEOUT/P2P_PING_MISSES cubren al par colgado o con el cable desconectado (sin RST):
# se declara caído tras MISSES timeouts seguidos. Valores por defecto pensados para una LAN de Pi.
P2P_PING_INTERVAL=3
P2P_PING_TIMEOUT=3
P2P_PING_MISSES=2

# Directorio de la cadena (chain.db, SQLite; P2-4). Distinto por nodo, p. ej. data/node_2
# Un chain.json antiguo se importa una vez y queda como chain.json.migrated.
DATA_DIR=data/chain

# Arranque (P2-4): fast = verifica enlaces, hash, PoW y Merkle de todos los bloques y
# recupera el estado de los contratos de la última foto (solo revalida por completo
# los bloques posteriores); full = revalida firmas y contratos desde el génesis.
# Usar full tras cambiar reglas de contratos o si se duda del contenido de DATA_DIR.
REVALIDATE_ON_START=fast
# Cada cuántos bloques se guarda una foto del estado de los contratos (0 = nunca).
SNAPSHOT_INTERVAL=100
# Anclaje público (idea 3): cada ANCHOR_INTERVAL bloques se envía el hash del bloque a los
# calendarios de OpenTimestamps (0 = apagado; el nodo hace llamadas HTTPS salientes si > 0).
# No es consenso y no bloquea al nodo. Ver docs/arquitectura.md.
ANCHOR_INTERVAL=0
# Quién envía el hash: auto (pbft: una sola réplica por bloque, rotando por índice; pow: todos
# los nodos con anclaje), always o never. Los demás nodos no tienen el .ots: GET /anchors dice
# qué réplica ancla cada bloque (campo "anchored_by") para pedírselo a ella.
ANCHOR_ROLE=auto
ANCHOR_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org

# Nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Dificultad inicial de minado, en BITS iniciales en cero del hash (P2-5).
# Cada bit duplica el trabajo esperado (2**bits intentos). Antes de P2-5 este
# valor contaba ceros hexadecimales (1 cero hex = 4 bits): un 4 antiguo equivale a 16.
# 16 bits ≈ 0,7 s por bloque vacío en un portátil (medido, no en un Pi); la regla lo lleva
# hacia 10 s por bloque. Es parámetro de consenso: igual en todos los nodos.
MINING_DIFFICULTY=16

# Llave privada de la autoridad UPB (firma el registro de emisores, P0-6).
# Solo la necesita el nodo que administra emisores. Nunca versionarla.
# Se genera con: venv\Scripts\python.exe scripts\crear_llave_autoridad.py
AUTHORITY_KEY_FILE=data/keys/authority.json

# URL pública base de los QR de verificación (P1-3), p. ej. http://192.168.1.100:8000.
# Vacío = se usa la URL con la que se accede a la API.
PUBLIC_BASE_URL=

# Dominio para did:web (P2-3), p. ej. upb.edu.bo. Vacío = el host de PUBLIC_BASE_URL
# o el de la petición. did:web exige servir /.well-known/did.json por HTTPS en ese dominio.
# REDES MULTINODO (PEERS o CONSENSUS=pbft): definir DID_WEB_DOMAIN con el MISMO
# valor en todos los nodos (PUBLIC_BASE_URL no basta: es distinta por nodo). Si no, cada nodo usa el host con que lo llaman y
# un VC exportado por un nodo no verifica contra otro. El nodo avisa en el log al arrancar.
DID_WEB_DOMAIN=

# Llave de administración (P1-9): minar, peers, emisores, poda, entrenar IA.
# Se envía en la cabecera X-API-Key. Si está vacía, esos endpoints solo aceptan
# peticiones desde la propia máquina (127.0.0.1 / ::1) con Host y Origin locales; el resto
# recibe 403. Se recomienda definirla en las Raspberry Pi (protege de CSRF/DNS rebinding).
ADMIN_API_KEY=
# /metrics (P2-10). true = sin autenticación: cualquiera que alcance la API lo lee.
# false (por defecto) = mismo control que los endpoints de administración: con ADMIN_API_KEY
# exige la cabecera X-API-Key (Prometheus debe enviarla); sin ADMIN_API_KEY solo responde a loopback.
METRICS_PUBLIC=false

# Orígenes CORS permitidos, separados por coma. Vacío = solo el propio nodo en
# localhost (http://localhost:API_PORT y http://127.0.0.1:API_PORT). Sin comodín "*".
CORS_ORIGINS=

# Límite de TX por minuto y por emisor que admite este nodo al mempool (P1-5).
# Superarlo devuelve 429 y genera una alerta. Política local, no de consenso.
TX_RATE_LIMIT=100

# ── IA federada (idea 6; NO es consenso) ──
# on|off (por defecto off). Con "on" el nodo intercambia con sus pares un resumen estadístico de
# su detector (mediana/MAD de 5 características, sin TX ni modelo) y banderas "AI_FLAG";
# FEDERATED_K = nodos distintos que deben marcar la misma TX o emisor para la alerta FEDERATED_ANOMALY.
# Solo es fiable con P2P_TLS=on (la identidad del par sale del certificado).
FEDERATED_AI=off
FEDERATED_K=2
# Cada cuántos bloques se repite la difusión del último resumen (0 = nunca); un par nuevo
# recibe además el resumen justo después del handshake.
FEDERATED_RESYNC_BLOCKS=10

# ── Freno térmico del minero (idea 5; solo local, NO es consenso) ──
# on|off. Con "on" el hilo de minado hace pausas cortas si el SoC supera THERMAL_SOFT_C,
# bajando hasta THERMAL_MIN_DUTY (fracción del tiempo trabajando) en THERMAL_HARD_C.
# No cambia la dificultad ni la validez de los bloques. Sin sensor (Windows) no hace nada.
THERMAL_THROTTLE=off
THERMAL_SOFT_C=70
THERMAL_HARD_C=80
THERMAL_MIN_DUTY=0.2

# Tope de TX pendientes en el mempool y por remitente (P1-5). Con el mempool lleno o el
# remitente en su tope, la TX nueva se rechaza (también las recibidas por P2P). Política local.
MEMPOOL_MAX=5000
MEMPOOL_MAX_PER_SENDER=64

# ── Consenso (P1-1) ───────────────────────────────────────────────
# pow (por defecto) o pbft. Es de TODA la red: un par con otro modo se rechaza.
# En pbft los bloques no se minan (POST /blocks/mine da 409): el primario propone uno
# cuando hay TXs y las réplicas lo confirman con 2f+1 COMMIT firmados (docs/arquitectura.md §4).
CONSENSUS=pow
# Lista ordenada de réplicas (igual en todos los nodos; el orden define el primario):
# {"replicas": [{"id": "node_1", "address": "192.168.1.100:8001", "public_key": "..."}]}
# Se arma con: venv\Scripts\python.exe scripts\crear_llave_replica.py --id node_1 --address 192.168.1.100:8001
# Objetivo UPB: 4 réplicas, 2 por Raspberry Pi (f = 1). Si cae un Pi caen 2 réplicas y PBFT se detiene.
PBFT_REPLICAS_FILE=pbft_replicas.json
# Llave privada de firma de ESTA réplica (nunca versionarla).
PBFT_KEY_FILE=data/keys/pbft_replica.json
# Segundos sin progreso (con TXs pendientes) antes de pedir cambio de vista.
PBFT_VIEW_TIMEOUT=5
# Intervalo mínimo entre propuestas del primario, en segundos.
PBFT_BATCH_INTERVAL=0.2
