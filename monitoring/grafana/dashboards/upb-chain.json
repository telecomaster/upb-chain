{
  "uid": "upb-chain",
  "title": "UPB-Chain",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["upb"],
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Altura de la cadena por nodo",
     "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
                  "expr": "upb_chain_height * on(instance) group_left(node_id) upb_node_info", "legendFormat": "{{node_id}}"}]},
    {"id": 2, "type": "timeseries", "title": "Dificultad (bits)",
     "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
                  "expr": "upb_difficulty_bits * on(instance) group_left(node_id) upb_node_info", "legendFormat": "{{node_id}}"}]},
    {"id": 3, "type": "timeseries", "title": "Mempool (TX pendientes)",
     "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
                  "expr": "upb_mempool_size * on(instance) group_left(node_id) upb_node_info", "legendFormat": "{{node_id}}"}]},
    {"id": 4, "type": "timeseries", "title": "Pares activos",
     "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
                  "expr": "upb_peers_active * on(instance) group_left(node_id) upb_node_info", "legendFormat": "{{node_id}}"}]},
    {"id": 5, "type": "timeseries", "title": "Alertas por severidad (todos los nodos)",
     "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
                  "expr": "sum by (severity) (upb_alerts)", "legendFormat": "{{severity}}"}]},
    {"id": 6, "type": "timeseries", "title": "Segundos desde el último bloque",
     "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
                  "expr": "upb_last_block_age_seconds * on(instance) group_left(node_id) upb_node_info", "legendFormat": "{{node_id}}"}]},
    {"id": 7, "type": "timeseries", "title": "Bloques minados localmente por minuto",
     "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
     "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "upb-prometheus"},
                  "expr": "rate(upb_blocks_mined_total[5m]) * 60 * on(instance) group_left(node_id) upb_node_info", "legendFormat": "{{node_id}}"}]}
  ]
}
